<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <Publicize>false</Publicize> <!--Allows access to originally private/protected members but may (unlikely to) cause errors.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
        <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">false</CopyModOnBuild>
        <PackOutputPath Condition="'$(PackOutputPath)' == ''">$(MSBuildProjectDirectory)/../.arena/build/SlayTheRequiem.pck</PackOutputPath>
        <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unrecorded</SourceRevisionId>
        <SourceTreeHash Condition="'$(SourceTreeHash)' == ''">unrecorded</SourceTreeHash>
        <GitDirty Condition="'$(GitDirty)' == ''">unrecorded</GitDirty>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')" >
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="$(Publicize)">
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- Версии закреплены (ревью R-02): API мода сверено с BaseLib 3.4.8 и игрой 0.107.1. Обновлять осознанно,
             вместе с min_version в SlayTheRequiem.json и прогоном smoke-чек-листа (docs/plan/completion-plan.md §3). -->
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="[3.4.8]" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="[0.2.1]" PrivateAssets="All"/>
        <!-- Generates a .pck file when building if only using simple assets. May not work on all setups. Uncomment to test. -->
        <!-- <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="All" /> -->
        <AdditionalFiles Include="SlayTheRequiem/localization/**/*.json"/> <!-- Used by analyzer -->
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="SlayTheRequiem/**" />
        <Compile Remove="SlayTheRequiem.Tests/**" /> <!-- тесты Core/ собираются отдельным проектом -->
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <EmbeddedResource Remove="SlayTheRequiem/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <!-- Таблицы правил дублируются в DLL (ревью R-06): если экспорт .pck их потеряет или Godot примет CSV
             за перевод, RequiemData прочитает встроенную копию. Имя ресурса: SlayTheRequiem.data.<файл>. -->
        <EmbeddedResource Include="SlayTheRequiem/data/*.csv" LogicalName="SlayTheRequiem.data.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore" />
        <None Include="SlayTheRequiem.json" />
        <None Include="project.godot"/>
        <None Include="SlayTheRequiem/**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="SlayTheRequiem\images\card_portraits\big\" />
      <Folder Include="SlayTheRequiem\images\powers\big\" />
      <Folder Include="SlayTheRequiem\images\relics\big\" />
    </ItemGroup>
    
    <ItemGroup>
        <AssemblyMetadata Include="GitCommit" Value="$(SourceRevisionId)" />
        <AssemblyMetadata Include="SourceTreeHash" Value="$(SourceTreeHash)" />
        <AssemblyMetadata Include="GitDirty" Value="$(GitDirty)" />
        <AssemblyMetadata Include="SaveSchema" Value="4" />
        <AssemblyMetadata Include="ShopProtocol" Value="2" />
        <AssemblyMetadata Include="SessionProtocol" Value="5" />
        <AssemblyMetadata Include="CreationSchema" Value="2" />
        <AssemblyMetadata Include="EconomyRevision" Value="1" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths">
        <Error Text="Legal game references required: sts2.dll and 0Harmony.dll must exist in Sts2DataDir. Set mod/Directory.Build.props or -p:Sts2DataDir=... . Core tests are a separate project."
               Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)/sts2.dll') or !Exists('$(Sts2DataDir)/0Harmony.dll')" />
    </Target>

    <!-- Opt-in legacy convenience only. Release/testing installation is tools/g0/mod_build.py install,
         which installs a verified, matching DLL/PCK pair instead of mixing a new DLL with yesterday's PCK. -->
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" Condition="'$(CopyModOnBuild)' == 'true' and '$(IsInnerGodotExport)' != 'true'">
        <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/$(AssemblyName).json" DestinationFolder="$(ModsPath)/$(MSBuildProjectName)/" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)/$(MSBuildProjectName)/" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
        <Warning Text="Only DLL/manifest installed. For testing a matching pair, use tools/g0/mod_build.py build + install." />
    </Target>

    <Target Name="ExportModPack">
        <Error Text="MegaDot 4.5.1 mono executable required in GodotPath. Export failure is fatal."
               Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')" />
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PackOutputPath)'))" />
        <Exec Command="&quot;$(GodotPath)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;BasicExport&quot; &quot;$(PackOutputPath)&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;CopyModOnBuild=false;MSBUILDDISABLENODEREUSE=1" />
        <Error Text="Export did not produce $(PackOutputPath)" Condition="!Exists('$(PackOutputPath)')" />
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish" DependsOnTargets="ExportModPack" Condition="'$(IsInnerGodotExport)' != 'true'" />
</Project>
